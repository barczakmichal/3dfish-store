# Database (PostgreSQL)
# Vercel Postgres: auto-ustawiane przez Vercel (POSTGRES_PRISMA_URL)
# Local: postgresql://paperclip:paperclip@localhost:54329/wedkarska_fabryka
# VPS: postgresql://user:password@host:5432/treefish
DATABASE_URL="postgresql://user:password@localhost:5432/treefish"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin panel
ADMIN_PASSWORD="your-secure-admin-password"

# App URL (required behind reverse proxy — used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL="https://treefish.pl"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cron jobs
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Slack notifications
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
